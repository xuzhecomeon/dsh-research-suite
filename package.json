{
  "name": "dsh-research-suite",
  "version": "3.2.0",
  "description": "科研全流程 DSH 插件：识别到科研诉求自动接管，10 个领域技能 + 15 个工具，把 450 条科研技能逐条判定后融合成 103 张能力卡 + 444 条可审计账本；能真跑 R/Python、生成并审计 docx、真检索 PubMed、核验 DOI、维护项目记忆。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "data",
    "knowledge",
    "references",
    "skills",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "research",
    "科研",
    "论文",
    "统计",
    "绘图",
    "文献",
    "审稿",
    "幻灯"
  ],
  "license": "MIT",
  "author": {
    "name": "dsh-research-suite contributors"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuzhecomeon/dsh-research-suite.git"
  },
  "homepage": "https://github.com/xuzhecomeon/dsh-research-suite#readme",
  "bugs": {
    "url": "https://github.com/xuzhecomeon/dsh-research-suite/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "testedWith": [
      "0.2.1-rc.5",
      "0.2.2-rc.1"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node scripts/selftest.mjs",
    "verify": "node scripts/verify-package.mjs",
    "verify:caps": "node scripts/verify-capabilities.mjs all",
    "verify:ledger": "node scripts/verify-ledger.mjs all",
    "eval:match": "node scripts/eval-match.mjs --strict",
    "test:verify": "node scripts/test-verify.mjs",
    "check": "node scripts/selftest.mjs && node scripts/verify-capabilities.mjs all && node scripts/verify-ledger.mjs all && node scripts/verify-package.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
