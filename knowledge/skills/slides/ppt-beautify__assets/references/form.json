          },
          {
            "key": "digital_trendy",
            "label": "网感潮流"
          },
          {
            "key": "party_civic",
            "label": "党建思政"
          },
          {
            "key": "grand_luxury",
            "label": "奢华大气"
          },
          {
            "key": "chinese_style",
            "label": "中国风"
          }
