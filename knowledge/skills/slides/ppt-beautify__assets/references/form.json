{
  "form": {
    "fields": [
      {
        "file_types": [
          "ppt",
          "image",
          "pdf"
        ],
        "hint": "支持 PDF、PPT、图片等；非任务执行、上传、大小处理、格式转换或完整性校验所必需，不解析附件；必要解析结果不得用于推测、补充或改写其他参数。",
        "key": "ref_files",
        "label": "参考文件",
