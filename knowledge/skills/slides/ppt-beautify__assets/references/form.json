  "schema_version": 1,
  "skill": {
    "category": "办公设计",
    "description": "美化现有PPT中的页面，调整字体、配色、版式和视觉层级。适用于PPT美化、PPT排版。美图设计室提供。",
    "id": "ppt-beautify",
    "title": "PPT美化"
  }
