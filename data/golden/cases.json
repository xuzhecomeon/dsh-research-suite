    { "id": "g14", "utterance": "帮我写个病例报告，按 CARE 清单来", "expect": { "domain": "writing", "cap": "writing.case-report" } },
    { "id": "g15", "utterance": "投稿前帮我自查一下，会不会一审就被秒拒", "expect": { "domain": "review", "cap": "review.presubmit" } },
