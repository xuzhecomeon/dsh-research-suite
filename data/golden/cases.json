    { "id": "g31", "utterance": "投稿包到底要准备哪些材料", "expect": { "domain": "format", "cap": "format.submission-package" } },
    { "id": "g32", "utterance": "SCI 英文稿想润色，但别改我的原意", "expect": { "domain": "polish", "cap": "polish.en" } },
