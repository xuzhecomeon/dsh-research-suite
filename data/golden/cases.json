    { "id": "g08", "utterance": "帮我查一下近五年骨盆骨折合并出血的文献", "expect": { "domain": "literature", "cap": "literature.search-plan", "alts": ["literature.federated-search"] } },
    { "id": "g09", "utterance": "国自然标书的研究内容和技术路线怎么写", "expect": { "domain": "ideation", "cap": "ideation.grant", "alts": ["ideation.design"] } },
    { "id": "g10", "utterance": "组会要讲一篇文献，帮我做个 PPT，备注栏也写好", "expect": { "domain": "slides", "cap": "slides.journal-club", "alts": ["slides.speaker-notes"] } },
    { "id": "g11", "utterance": "审稿人让我补一个倾向评分匹配分析", "expect": { "domain": "stats", "cap": "stats.psm" } },
    { "id": "g12", "utterance": "这段话查重率太高了，帮我降重", "expect": { "domain": "polish", "cap": "polish.rewrite", "alts": ["polish.audit"] } },
