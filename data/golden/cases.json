    { "id": "g28", "utterance": "EndNote 里的文献怎么桥接到 Word 里生成上标编号", "expect": { "domain": "format", "cap": "format.ref-bridge", "alts": ["format.intext-cite"] } },
    { "id": "g29", "utterance": "帮我出一张森林图", "expect": { "domain": "figures", "cap": "figures.statplot", "alts": ["stats.meta"] } },
